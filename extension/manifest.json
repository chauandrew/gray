{
  "manifest_version": 3,
  "name": "Gray – Block Images & Mute Video",
  "version": "0.1.4",
  "description": "Blocks images and mutes video at the network level for faster, lighter, distraction-free pages. No account, no tracking.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": ["storage", "activeTab", "declarativeNetRequest", "alarms"],
  "background": { "service_worker": "sw.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/32.png"
  },
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "block_images",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["gray.css"],
      "js": ["match.js", "gray.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
